# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

# App URL for OAuth redirects (must match Clerk dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

CLERK_JWT_ISSUER_DOMAIN=

# Google OAuth - set to 'true' to enable Google Sign-in/Sign-up
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Development-only routes authentication - set to 'true' to disable auth for /database and /dev-tools
NEXT_PUBLIC_DEV_ONLY_ROUTE_NO_AUTH=false
DEV_ONLY_ROUTE_NO_AUTH=false

EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=