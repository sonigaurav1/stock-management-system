{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "contextProviders": [
    {
      "type": "file",
      "path": "/.claude/projects/-Users-gaurav-Desktop-Invento/project-graph.md",
      "autoLoad": true,
      "description": "Invento project graph"
    }
  ]
}